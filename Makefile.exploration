# Makefile.exploration for DESTINY data exploration, surrogate training, and inverse design

# --- Configuration Defaults ---
TECH ?= SRAM
NUM_VARIANTS ?= 2000
TRIALS ?= 30
STUDY_NAME ?= destiny_$(TECH)

# Technologies supported for multi-tech pipeline
TECHS = SRAM RRAM eDRAM

# --- Inverse Design Parameter Defaults ---
INV_NODE ?= 32
INV_ROADMAP ?= HP
INV_OPT_STEPS_TARGET ?= 800
INV_OPT_STEPS_OBJ ?= 500
INV_MAX_TARGETS ?= 1
INV_VALIDATE_TOP_TARGET ?= 1
INV_VALIDATE_TOP_OBJ ?= 2

.PHONY: help all data_exploration generate explore analyze plot ml_surrogate tune train inverse_design inverse_design_target inverse_design_objective end_to_end clean clean_models clean_opt clean_all

help:
	@echo "DESTINY Exploration, Surrogate, and Inverse Design Pipeline"
	@echo "============================================================"
	@echo "Usage: make -f Makefile.exploration [target] [TECH=SRAM|RRAM|eDRAM|ALL]"
	@echo ""
	@echo "Main Targets:"
	@echo "  data_exploration         Run cell generation, exploration simulation, Pareto analysis, and plot."
	@echo "  ml_surrogate             Tune and train surrogate models (supports TECH=ALL or TECH=SRAM/RRAM/eDRAM)."
	@echo "  inverse_design           Run inverse design target-matching and objective-minimization sweeps."
	@echo "  inverse_design_target    Run inverse design target-matching sweep."
	@echo "  inverse_design_objective Run inverse design objective-minimization sweep."
	@echo "  end_to_end               Run the entire pipeline (data_exploration -> ml_surrogate -> inverse_design)."
	@echo ""
	@echo "Cleaning Targets:"
	@echo "  clean                    Remove transient data files (synthetic cells, raw simulation results, Pareto)."
	@echo "  clean_models             Remove models and Optuna tuning databases."
	@echo "  clean_opt                Remove inverse design optimization output directories."
	@echo "  clean_all                Remove all transient data, models, and optimization outputs."

# --- Data Exploration Target ---
data_exploration: generate explore analyze plot

generate:
	@echo "--- Step 1: Generating synthetic cells (TECH=$(TECH)) ---"
	python3 generate_cells.py --tech $(TECH) --num_variants $(NUM_VARIANTS)

explore:
	@echo "--- Step 2: Running parallel simulations (TECH=$(TECH)) ---"
	python3 run_exploration.py --tech $(TECH)

analyze:
	@echo "--- Step 3: Performing Pareto frontier and feasibility analysis (TECH=$(TECH)) ---"
	python3 pareto_analysis.py --tech $(TECH)

plot:
	@echo "--- Step 4: Generating Pareto visualization ---"
	python3 visualize_pareto.py --pareto pareto/pareto.csv

# --- ML Surrogate Target ---
ml_surrogate:
ifeq ($(TECH), ALL)
	@for tech in $(TECHS); do \
		echo "--- Running ML pipeline for $$tech ---"; \
		$(MAKE) -f Makefile.exploration tune train TECH=$$tech STUDY_NAME=destiny_$$tech; \
	done
else
	@$(MAKE) -f Makefile.exploration tune train TECH=$(TECH) STUDY_NAME=$(STUDY_NAME)
endif

tune:
	@echo "--- Hyperparameter Tuning for $(TECH) (study: $(STUDY_NAME)) ---"
	python3 tune_model.py --tech $(TECH) --trials $(TRIALS) --study-name $(STUDY_NAME)

train:
	@echo "--- Training Surrogate Model for $(TECH) (from study: $(STUDY_NAME)) ---"
	python3 train_model.py --tech $(TECH) --from-study $(STUDY_NAME) --eval-on-test

# --- Inverse Design Target ---
inverse_design: inverse_design_target inverse_design_objective

inverse_design_target:
	@echo "--- Running Inverse Design (Target Sizing Sweep) ---"
	python3 inverse_design_sweep_target.py \
		--tech $(TECH) \
		--node $(INV_NODE) \
		--roadmap $(INV_ROADMAP) \
		--max-targets $(INV_MAX_TARGETS) \
		--validate-top $(INV_VALIDATE_TOP_TARGET) \
		--opt-steps $(INV_OPT_STEPS_TARGET)

inverse_design_objective:
	@echo "--- Running Inverse Design (Objective Sizing Sweep) ---"
	python3 inverse_design_sweep_objective.py \
		--tech $(TECH) \
		--node $(INV_NODE) \
		--roadmap $(INV_ROADMAP) \
		--targets cache_area_mm2 cache_hit_latency_ns \
		--validate-top $(INV_VALIDATE_TOP_OBJ) \
		--capacity-kb 2 \
		--associativity 4 \
		--opt-steps $(INV_OPT_STEPS_OBJ)

# --- End to End Target ---
end_to_end:
	@echo "=========================================================="
	@echo "  Starting End-to-End DESTINY Optimization & Sizing Pipeline"
	@echo "=========================================================="
	$(MAKE) -f Makefile.exploration data_exploration TECH=$(TECH)
	$(MAKE) -f Makefile.exploration ml_surrogate TECH=$(TECH)
ifeq ($(TECH), ALL)
	@for tech in $(TECHS); do \
		echo "--- Running Inverse Design for $$tech ---"; \
		$(MAKE) -f Makefile.exploration inverse_design TECH=$$tech; \
	done
else
	$(MAKE) -f Makefile.exploration inverse_design TECH=$(TECH)
endif

# --- Cleaning ---
clean:
	@echo "Cleaning transient data and run outputs..."
	rm -rf synthetic_cells/ exploration_results/ failed_exploration/ pareto/

clean_models:
	@echo "Cleaning saved models and study databases..."
	rm -rf model_output/ optuna_study.db

clean_opt:
	@echo "Cleaning inverse design optimization outputs..."
	rm -rf opt_target/ opt_obj/

clean_all: clean clean_models clean_opt
	@echo "All generated outputs and models cleared."
