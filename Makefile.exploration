# Makefile.exploration for parameterized DESTINY design space exploration

# --- Configuration ---
# Mode: standard (mixed physics) or arch (fixed-physics architectural sweep)
MODE ?= standard
# Memory type: SRAM, RRAM, eDRAM, or ALL
TYPE ?= ALL
# Number of variants to generate per technology (only applies to standard mode)
NUM_VARIANTS ?= 2000
# Technologies handled by the ALL logic
TECHS = SRAM RRAM eDRAM
# Optuna study name — shared between tune and train so best HPs are picked up
STUDY_NAME ?= destiny_$(TYPE)$(SUFFIX)

# --- Paths ---
RAM_DIR = /dev/shm/vjuricek_destiny_tmp

# --- Script Logic (Switches based on MODE) ---
ifeq ($(MODE), arch)
	GENERATE_SCRIPT = generate_cells_arch.py
	EXPLORE_SCRIPT  = run_exploration_arch.py
	ANALYZE_SCRIPT  = pareto_analysis.py
	TUNE_SCRIPT     = tune_model.py
	PLOT_SCRIPT     = visualize_pareto_arch.py
	TRAIN_SCRIPT    = train_model.py
	INV_DESIGN_SCRIPT = inverse_design.py
	SUFFIX = _arch
	ARCH_FLAG = --arch
else
	GENERATE_SCRIPT = generate_cells.py
	EXPLORE_SCRIPT  = run_exploration.py
	ANALYZE_SCRIPT  = pareto_analysis.py
	TUNE_SCRIPT     = tune_model.py
	PLOT_SCRIPT     = visualize_pareto.py
	TRAIN_SCRIPT    = train_model.py
	INV_DESIGN_SCRIPT = inverse_design.py
	SUFFIX =
	ARCH_FLAG =
endif


# --- Main Targets ---
.PHONY: help all exploration generate explore analyze plot train ml_pipeline clean clean_studies clean_all

help:
	@echo "DESTINY Exploration Pipeline"
	@echo "Usage: make -f Makefile.exploration [target] [MODE=standard|arch] [TYPE=SRAM|RRAM|eDRAM|ALL]"
	@echo ""
	@echo "Modes:"
	@echo "  standard    Full-stack sweep (Arch + Physics), uses random sampling."
	@echo "  arch        Architectural sweep (Fixed Physics), uses Cartesian grid."
	@echo ""
	@echo "Main Targets:"
	@echo "  all            Run everything: exploration, then ml_pipeline"
	@echo "  exploration    Run generate -> explore -> analyze -> plot"
	@echo "  ml_pipeline    Train and validate surrogate model(s)"
	@echo "  clean_studies  Delete all Optuna tuning studies from the DB"
	@echo ""

# Orchestration
all: exploration ml_pipeline

# --- Data Exploration Phase ---

exploration: kill generate explore analyze plot

kill:
	@echo "--- Killing stale DESTINY and Python processes ---"
	-pkill -9 -f $(EXPLORE_SCRIPT)
	-pkill -9 -u $(shell whoami) destiny
	@sleep 1

generate:
	@echo "--- Step 1: Generating cells (MODE=$(MODE), TYPE=$(TYPE)) ---"
	python3 $(GENERATE_SCRIPT) --type $(TYPE)

explore:
	@echo "--- Step 2: Running parallel simulations for $(TYPE)$(SUFFIX) ---"
	python3 $(EXPLORE_SCRIPT) --type $(TYPE)

analyze:
	@echo "--- Step 3: Performing Pareto analysis for $(TYPE)$(SUFFIX) ---"
	python3 $(ANALYZE_SCRIPT) --type $(TYPE) $(ARCH_FLAG)

plot:
	@echo "--- Step 4: Generating Pareto visualization for $(TYPE)$(SUFFIX) ---"
	@if [ "$(MODE)" = "arch" ]; then \
		if [ "$(TYPE)" = "ALL" ]; then \
			for tech in $(TECHS); do python3 $(PLOT_SCRIPT) --tech $$tech; done \
		else \
			python3 $(PLOT_SCRIPT) --tech $(TYPE); \
		fi \
	else \
		python3 $(PLOT_SCRIPT); \
	fi

# --- ML Surrogate Pipeline ---

ml_pipeline:
ifeq ($(TYPE), ALL)
	@for tech in $(TECHS); do \
		echo "--- Running ML Pipeline for $$tech ($(MODE)) ---"; \
		$(MAKE) -f Makefile.exploration tune train TYPE=$$tech MODE=$(MODE); \
	done
else
	@$(MAKE) -f Makefile.exploration tune train TYPE=$(TYPE) MODE=$(MODE)
endif

tune:
	@echo "--- Hyperparameter Tuning for $(TYPE)$(SUFFIX) (study: $(STUDY_NAME)) ---"
	python3 $(TUNE_SCRIPT) --tech $(TYPE) $(ARCH_FLAG) --trials 20 --study-name $(STUDY_NAME)

train:
	@echo "--- Training Surrogate Model for $(TYPE)$(SUFFIX) (from study: $(STUDY_NAME)) ---"
	python3 $(TRAIN_SCRIPT) --tech $(TYPE) $(ARCH_FLAG) --from-study $(STUDY_NAME) --eval-on-test


design:
	@echo "--- Running Inverse Design for $(TYPE)$(SUFFIX) ---"
	python3 $(INV_DESIGN_SCRIPT) --tech $(TYPE) $(ARCH_FLAG)

# --- Cleaning ---

clean_studies:
	@echo "--- Deleting all Optuna tuning studies and clearing tuning artifacts ---"
	@python3 -c "import optuna; \
storage = 'sqlite:///optuna_study.db'; \
summaries = optuna.get_all_study_summaries(storage=storage); \
[optuna.delete_study(study_name=s.study_name, storage=storage) for s in summaries]; \
print(f'Done. {len(summaries)} study/studies removed.')"
	rm -rf model_output/tuning/

clean:
ifeq ($(TYPE), ALL)
	@echo "--- Cleaning all data for $(TECHS) ($(MODE)) ---"
	@for tech in $(TECHS); do \
		rm -rf $(RAM_DIR)/$$tech$(SUFFIX); \
		rm -rf exploration_results/$$tech$(SUFFIX); \
		rm -rf pareto/$$tech$(SUFFIX); \
		rm -rf pareto/plots/$$tech$(SUFFIX); \
	done
else
	@echo "--- Cleaning data for $(TYPE) ($(MODE)) ---"
	rm -rf $(RAM_DIR)/$(TYPE)$(SUFFIX)
	rm -rf exploration_results/$(TYPE)$(SUFFIX)
	rm -rf pareto/$(TYPE)$(SUFFIX)
	rm -rf pareto/plots/$(TYPE)$(SUFFIX)
endif

clean_all: clean_studies
	@echo "Cleaning up ALL generated outputs across ALL modes..."
	rm -rf synthetic_cells/ exploration_results/ pareto/ model_output/ $(RAM_DIR)/
